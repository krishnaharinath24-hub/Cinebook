# CineBook Environment Configuration Template
# -------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env     (Linux/macOS)
#      copy .env.example .env   (Windows Command Prompt)
#      cp .env.example .env     (PowerShell)
# 2. Update the values below for your environment.
# 3. NEVER commit the actual '.env' file to Git or version control!
# -------------------------------------------------------------

# Django Secret Key
# In production, generate a secure random key using:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-keep-this-strictly-confidential

# Debug Mode: True for local development, False for production deployment
DJANGO_DEBUG=False

# Allowed Hosts: Comma-separated list of domain names or IP addresses
# In development: 127.0.0.1,localhost
# In production: yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
